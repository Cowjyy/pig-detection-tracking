# Keep the agreed layout, without publishing dataset contents.
/datasets/raw/*
!/datasets/raw/README.md
!/datasets/raw/inventory.json
/datasets/processed/*
!/datasets/processed/README.md
/datasets/annotations/*
!/datasets/annotations/README.md
/datasets/splits/*
!/datasets/splits/README.md
!/datasets/splits/protocol_v2/
/checkpoints/*
!/checkpoints/README.md
!/checkpoints/.gitkeep

# Publish only the curated, small result snapshot, not run outputs or upload tools.
/experiments/*
!/experiments/README.md
!/experiments/results/
!/experiments/.gitkeep
!/experiments/results/run_20261022_01/figures/detection_accuracy_speed.png
!/experiments/results/run_20261022_01/figures/tracking_accuracy_speed.png

# Local handover notes, server connection records and Word deliverables stay local.
/docs/*
!/docs/reproduction.md
!/docs/results.md
!/docs/repository_contents.md
!/docs/third_party.md
!/docs/data_audit.md
!/docs/data_splits.md
!/docs/data_resolution.md
!/docs/coordinate_protocol.md
